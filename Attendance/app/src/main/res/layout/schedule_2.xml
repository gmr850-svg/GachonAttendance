<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scheduleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 영역 -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="122dp"
            android:layout_height="44dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/menu"
            android:tint="#555555" />
    </LinearLayout>

    <!-- 메인 콘텐츠 -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- 제목 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvScheduleTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="시간표"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- 시간표 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/scheduleCard"
            android:layout_width="match_parent"
            android:layout_height="326dp"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:id="@+id/timeTableFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="28dp"
                android:paddingTop="10dp"
                android:paddingEnd="24dp"
                android:paddingBottom="10dp">

                <!-- 시간표 기본 그리드 -->
                <TableLayout
                    android:id="@+id/tableScheduleGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:stretchColumns="1,2,3,4,5">

                    <!-- 요일 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="22dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text=""
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:gravity="center"
                            android:text="월"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:gravity="center"
                            android:text="화"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:gravity="center"
                            android:text="수"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:gravity="center"
                            android:text="목"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF"
                            android:gravity="center"
                            android:text="금"
                            android:textColor="#777777"
                            android:textSize="10sp" />
                    </TableRow>

                    <!-- 9시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="48dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="9"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 10시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="48dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="10"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 11시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="48dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="11"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 12시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="48dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="12"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 1시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="48dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="1"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 2시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="48dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="2"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>
                </TableLayout>

                <!-- 백엔드 시간표 데이터를 받아서 과목 블록을 올릴 영역 (Room DB → 동적 생성) -->
                <FrameLayout
                    android:id="@+id/classBlockLayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="26dp"
                    android:paddingTop="22dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 현재 시간에 해당하는 수업이 있을 때: 좌우 슬라이드 카드 -->
        <HorizontalScrollView
            android:id="@+id/currentClassSlider"
            android:layout_width="match_parent"
            android:layout_height="146dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/currentClassSlideContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- 1페이지: 예정된 수업 요약 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/currentClassSummaryCard"
                    android:layout_width="324dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/tvCurrentClassLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:text="예정된 수업"
                            android:textColor="@color/primarybase"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCurrentClassName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:text="모바일 프로그래밍"
                            android:textColor="@color/primarybase"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:id="@+id/tvDetailClassName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_bold"
                                android:text="모바일 프로그래밍 (영어강의)"
                                android:textColor="@color/primarybase"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailProfessor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/pretendard_medium"
                                android:text="민홍"
                                android:textColor="#444444"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="70dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/pretendard_medium"
                                    android:text="학기"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvDetailSemester"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/pretendard_medium"
                                    android:gravity="end"
                                    android:text="26년 1학기"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="70dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/pretendard_medium"
                                    android:text="시간"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvDetailTime"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/pretendard_medium"
                                    android:gravity="end"
                                    android:text="화 14:00-15:00, 목 13:00-15:00"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="70dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/pretendard_medium"
                                    android:text="장소"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvDetailRoom"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/pretendard_medium"
                                    android:gravity="end"
                                    android:text="AI관-301"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="70dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/pretendard_medium"
                                    android:text="과목코드"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvDetailCourseCode"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/pretendard_medium"
                                    android:gravity="end"
                                    android:text="14454001"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/detailIndicatorArea"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:gravity="bottom|center"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/bg_indicator_inactive" />

                                <TextView
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_indicator_active" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCurrentProfessor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/pretendard_medium"
                            android:gravity="center"
                            android:text="민홍"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/currentClassTimeArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivCurrentClassClock"
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/tabler_clock"
                                android:tint="#555555" />

                            <TextView
                                android:id="@+id/tvCurrentClassTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/pretendard_medium"
                                android:text="10:00 ~ 10:50"
                                android:textColor="#333333"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCurrentClassRoom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/pretendard_medium"
                            android:gravity="center"
                            android:text="AI관-301"
                            android:textColor="#555555"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:id="@+id/summaryIndicatorArea"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="bottom|center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/bg_indicator_active" />

                            <TextView
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_indicator_inactive" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2페이지: 수업 상세 정보 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/currentClassDetailCard"
                    android:layout_width="324dp"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 현재 시간에 수업이 없을 때 보여줄 카드: Kotlin에서 필요하면 visible로 변경 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/currentClassEmptyCard"
            android:layout_width="match_parent"
            android:layout_height="146dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvNoCurrentClass"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center"
                android:text="예정된 수업이 없습니다."
                android:textColor="@color/primarybase"
                android:textSize="20sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- 하단 메뉴 -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="@color/primarybase"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBottomHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="24dp"
            android:src="@drawable/home"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="24dp"
            android:src="@drawable/retry"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="24dp"
            android:src="@drawable/bell"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="24dp"
            android:src="@drawable/calendar"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="24dp"
            android:src="@drawable/back"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>