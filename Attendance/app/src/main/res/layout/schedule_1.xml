<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scheduleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="122dp"
            android:layout_height="44dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/menu"
            android:tint="#555555" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvScheduleTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="시간표"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/scheduleCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="26dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <FrameLayout
                    android:id="@+id/timeTableFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:orientation="horizontal">
                            <TextView android:layout_width="28dp" android:layout_height="match_parent"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="월" android:textColor="#A3A3A3" android:textSize="11sp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="화" android:textColor="#A3A3A3" android:textSize="11sp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="수" android:textColor="#A3A3A3" android:textSize="11sp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="목" android:textColor="#A3A3A3" android:textSize="11sp"/>
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="금" android:textColor="#A3A3A3" android:textSize="11sp"/>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:background="#E0E0E0"/>

                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="9" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="10" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="11" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="12" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="1" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="2" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="3" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="4" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="5" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="6" android:gravity="end" android:paddingEnd="6dp" android:textColor="#B2B2B2" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:layout_marginStart="28dp" android:background="#F3F3F3"/>
                        </FrameLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="28dp"
                        android:layout_marginTop="24dp"
                        android:background="#E0E0E0"/>

                    <FrameLayout
                        android:id="@+id/classBlockLayer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="29dp"
                        android:paddingTop="25dp" />
                </FrameLayout>
            </ScrollView>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="수업 추가"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/etSubjectCodeInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="과목코드 입력"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#111111"
                        android:textColorHint="#A3A3A3"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:inputType="text" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    app:cardBackgroundColor="#004B83"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/btnAddSubject"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="추가"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/currentClassEmptyCard"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvNoCurrentClass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/pretendard_bold"
                    android:gravity="center"
                    android:text="예정된 수업이 없습니다."
                    android:textColor="@color/primarybase"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </FrameLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/primarybase"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBottomHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/home"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/retry"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/bell"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/calendar"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/back"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>